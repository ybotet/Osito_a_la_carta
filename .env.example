# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Base de datos (SQLite) ---
DATABASE_URL=./osito.db

# --- Auth (JWT) ---
# Minimo 32 caracteres cada uno. Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambia-esto-otro-secreto-de-al-menos-32-caracteres

# --- Publico (imagenes) ---
# Origen del sitio, sin barra final. Se antepone a la ruta relativa que se guarda en la
# BD (imageUrl = /uploads/dishes/x.jpg) para componer la URL que ve el cliente. Cambiar
# de dominio es cambiar esta variable, no reescribir filas.
PUBLIC_ORIGIN=http://localhost:3000
# Directorio donde se escriben las imagenes subidas. En la VPS va FUERA del repo
# (/var/www/osito/uploads) para que un despliegue no las borre. Nginx lo sirve con un alias.
UPLOADS_DIR=./uploads

# --- Correo (Mailgun) ---
# API key de Mailgun (https://dashboard.mailgun.com). En produccion, genera
# uno real con: openssl rand -hex 32
MAILGUN_API_KEY=
# Dominio verificado en Mailgun (p. ej. mg.tudominio.com)
MAILGUN_DOMAIN=
# Remitente: "Nombre <email>" o solo email
MAILGUN_FROM=Osito a la carta <no-reply@tudominio.com>
# Destinatario(s) del chef. Puede ser un solo email o una lista separada por
# coma, para notificar a mas de una persona sin cambiar el schema.
CHEF_EMAIL=chef@tudominio.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
