# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Base de datos (SQLite) ---
DATABASE_URL=./osito.db

# --- Auth (JWT) ---
# Minimo 32 caracteres cada uno. Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambia-esto-otro-secreto-de-al-menos-32-caracteres

# --- Correo (Mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Osito a la carta <no-reply@tudominio.com>
CHEF_EMAIL=chef@tudominio.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
